{
  "name": "fullstack-monitoring-app",
  "version": "1.0.0",
  "description": "Fullstack app with monitoring Prometheus and Grafana",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "nodemon server/src/index.js",
    "server": "nodemon server/src/index.js",
    "web": "npm run dev --prefix web",
    "dev:all": "concurrently -n server,web -c green,cyan \"npm run server\" \"npm run web\"",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.5.0",
    "nodemon": "^2.0.20"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
